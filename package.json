{
  "name": "agent-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Local OpenAI-compatible proxy that forwards to the Codex ChatGPT backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "tsx scripts/buildBinary.ts",
    "build:appimage": "tsx scripts/buildAppImage.ts",
    "verify:binary": "tsx scripts/verifyBinary.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "poc": "tsx scripts/poc.ts",
    "poc:claude": "tsx scripts/claudePoC.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "xxhash-wasm": "1.1.0"
  }
}
